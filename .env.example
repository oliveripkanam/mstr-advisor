# Yahoo Finance Proxy Configuration
# These env vars control how Yahoo Finance API calls are routed

# Primary: Cloudflare Worker proxy URL (recommended for production)
# Example: https://mstr-yahoo-proxy.your-subdomain.workers.dev
VITE_YAHOO_PROXY_URL=

# Secondary: Vercel serverless function URL (optional fallback)
# Example: https://your-app.vercel.app/api/yahoo
VITE_YAHOO_VERCEL_URL=

# Enable Yahoo Quote v7 API endpoint (may return 401 for some regions)
# Set to 'true' to enable pre/post market pricing from quote endpoint
# Set to 'false' or omit to use chart endpoint only (more reliable)
# Default: false
VITE_ENABLE_YAHOO_QUOTE_V7=false

# Note: If both proxy URLs are unset, the app will use '/api/yahoo' 
# which works in development via Vite proxy, but requires Netlify 
# redirects in production (see netlify.toml)
